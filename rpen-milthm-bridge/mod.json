{
  "protocol": "rpen-mod",
  "api": 1,
  "id": "milthm-fmt2-bridge",
  "name": {
    "zh-CN": "Milthm 自制谱桥接",
    "en-US": "Milthm fmt=2 Bridge"
  },
  "version": "0.6.4",
  "author": {
    "zh-CN": "可行性验证原型",
    "en-US": "Feasibility prototype"
  },
  "description": {
    "zh-CN": "在 RPEN 中导入/编辑/导出 Milthm 自制谱（fmt=2），轨道式。v0.6.4：修复在 Milthm 谱面里新增/批量增加判定线后出现的「初始化事件列」死循环（会让判定线面板按钮点不动、撤销栈被打满）；新加的线会即时转成 Milthm 轨道线。v0.6.3：不透明度事件（2/8/9/13）的钩定状态跨提交保持，导入的零时长透明度事件按钩定显示，编辑一条不再重写同列其它事件。v0.6.2：缺失的线透明度轨道补「0 拍起 1 拍 0」+「最早透明度事件拍 255」两条初始化事件，导出时过滤。",
    "en-US": "Import/edit/export Milthm fan charts (fmt=2) in RPEN. Track-based: each judge line = one Milthm track, notes locked to track center (positionX=0). v0.6.4 fixes an endless \"initialise event columns\" commit loop after adding plain judge lines to a Milthm chart (it froze the judge-line panel); added lines are converted to Milthm track lines immediately. Export commands produce Milthm chart.json / package zip."
  },
  "entry": "main.mjs",
  "settings": {
    "coord-scale": {
      "type": "number",
      "label": {
        "zh-CN": "坐标缩放（Milthm→RPE）",
        "en-US": "Coordinate scale (Milthm→RPE)"
      },
      "default": 0.703125,
      "min": 0.05,
      "max": 20,
      "step": 0.001
    },
    "flip-y": {
      "type": "boolean",
      "label": {
        "zh-CN": "Y 轴翻转（默认关：两者都是 Y 向上）",
        "en-US": "Flip Y (when Milthm Y is down)"
      },
      "default": false
    },
    "offset-x": {
      "type": "number",
      "label": {
        "zh-CN": "X 偏移（Milthm 单位）",
        "en-US": "X offset (Milthm units)"
      },
      "default": 0,
      "min": -5000,
      "max": 5000,
      "step": 1
    },
    "offset-y": {
      "type": "number",
      "label": {
        "zh-CN": "Y 偏移（Milthm 单位）",
        "en-US": "Y offset (Milthm units)"
      },
      "default": 0,
      "min": -5000,
      "max": 5000,
      "step": 1
    },
    "rotation-offset": {
      "type": "number",
      "label": {
        "zh-CN": "旋转偏移（度，Milthm→RPE；90 为两者基准差）",
        "en-US": "Rotation offset (deg, Milthm→RPE; 90 = base difference)"
      },
      "default": 90,
      "min": -360,
      "max": 360,
      "step": 1
    },
    "speed-scale": {
      "type": "number",
      "label": {
        "zh-CN": "流速缩放（Milthm Speed→RPE speed）",
        "en-US": "Speed scale"
      },
      "default": 1.1671875,
      "min": 0.01,
      "max": 100,
      "step": 0.01
    },
    "lane-lock": {
      "type": "boolean",
      "label": {
        "zh-CN": "锁定轨道式编辑（音符 X 恒为 0）",
        "en-US": "Lock track-based editing (note X = 0)"
      },
      "default": true
    },
    "keep-extra": {
      "type": "boolean",
      "label": {
        "zh-CN": "保留无法编辑的 Milthm 数据以便原样导出",
        "en-US": "Preserve uneditable Milthm data for export"
      },
      "default": true
    },
    "preview-tracks": {
      "type": "boolean",
      "label": {
        "zh-CN": "预览里画 Milthm 轨道样式",
        "en-US": "Draw Milthm-style tracks in preview"
      },
      "default": true
    },
    "preview-dim": {
      "type": "boolean",
      "label": {
        "zh-CN": "预览背景明暗（全局事件）",
        "en-US": "Preview background dim (global events)"
      },
      "default": true
    },
    "dim-migrate": {
      "type": "boolean",
      "label": {
        "zh-CN": "导入时把纯黑立绘自动迁移为背景明暗全局事件",
        "en-US": "Auto-migrate black storyboards to background-dim global events on import"
      },
      "default": true
    },
    "new-chart-mode": {
      "type": "select",
      "label": {
        "zh-CN": "新建谱面时",
        "en-US": "When creating a chart"
      },
      "default": "ask",
      "options": {
        "ask": {
          "zh-CN": "询问谱面类型",
          "en-US": "Ask chart type"
        },
        "rpe": {
          "zh-CN": "直接新建普通 RPE",
          "en-US": "Always plain RPE"
        },
        "milthm": {
          "zh-CN": "直接新建 Milthm 轨道谱面",
          "en-US": "Always Milthm track chart"
        }
      }
    }
  }
}